{
  "version": "0.3.0",
  "configurations": [
    {
      "name": "Android Dev 📱",
      "type": "dart",
      "request": "launch",
      "preLaunchTask": "run-adb-reverse",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "dev",
        "--dart-define=ENV=dev",
        "--track-widget-creation",
        "--no-enable-impeller"
      ],
      "deviceId": "CPH2325",
      "attachToExistingApp": false,
      "showDebuggerOnStart": true
    },
    {
      "name": "Dev Web 🌐",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=ENV=local",
        "--web-port",
        "8080",
        "--web-hostname",
        "localhost",
        "--web-browser-flag=--disable-features=PrivacySandboxAdsApis"
      ],
      "deviceId": "chrome"
    },
  ]
}